+def _orchestration_error_for(error: Exception | None):
+    if isinstance(error, IntegrationError):
+        return error.orchestration_error
+    return None
+
+
+def _provider_terminal_status_for(error: Exception | None):
+    orchestration_error = _orchestration_error_for(error)
+    value = getattr(orchestration_error, "provider_status", None)
+    if not isinstance(value, str):
+        return None
+    try:
+        return ProviderLifecycleStatus(value)
+    except ValueError:
+        return None
+
+
+def _provider_failure_diagnostic_fields(error: Exception | None) -> dict[str, object]:
+    orchestration_error = _orchestration_error_for(error)
+    progress = getattr(orchestration_error, "last_provider_progress", None)
+    return {
+        "error_category": (
+            error.category.value if isinstance(error, IntegrationError) else None
+        ),
+        "error_phase": getattr(
+            getattr(orchestration_error, "phase", None), "value", None
+        ),
+        "provider_status": getattr(orchestration_error, "provider_status", None),
+        "provider_request_id": getattr(
