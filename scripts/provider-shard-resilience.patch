+def _is_retryable_provider_poll_error(exc: ProviderClientError) -> bool:
+    return bool(
+        exc.detail.retryable
+        and exc.detail.category
+        in {ProviderErrorCategory.UNAVAILABLE, ProviderErrorCategory.TIMEOUT}
+    )
+
+
+def _log_provider_poll_retry(
+    *,
+    phase: OrchestrationPhase,
+    provider_job_id: str,
+    snapshot: ProviderJobStatus | None,
+    error: ProviderClientError,
+    consecutive_error_count: int,
+    poll_count: int,
+) -> None:
+    print(
+        "PDF_PROVIDER_POLL_RETRY "
+        f"phase={phase.value} "
+        f"provider_job_id={provider_job_id} "
+        f"provider_status={_snapshot_status(snapshot)} "
+        f"error_category={error.detail.category.value} "
+        f"consecutive_error_count={consecutive_error_count} "
+        f"poll_count={poll_count}",
+        file=sys.stderr,
