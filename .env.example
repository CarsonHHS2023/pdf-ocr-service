API_HOST=0.0.0.0
API_PORT=8000

# Temporary shared development access gate. Keep disabled until the frontend
# login flow is deployed and the two secrets below are configured.
APP_ACCESS_ENABLED=false
APP_ACCESS_PASSWORD_HASH=
APP_ACCESS_TOKEN_SECRET=
APP_ACCESS_TOKEN_TTL_SECONDS=43200

# Comma-separated origins. Leave unset to use the built-in GitHub Pages and
# localhost development defaults.
APP_CORS_ORIGINS=
